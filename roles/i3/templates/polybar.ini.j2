# Include Catppuccin Mocha theme
include-file =  $HOME/.config/polybar/mocha.ini

[bar/example]
width = 100%
heigh = 16pt
radius = 8

background = ${colors.base}
foreground = ${colors.text}

line-size = 2pt

border-size = 2pt
border-color = ${colors.surface0}

padding-left = 2
padding-right = 2

module-margin = 1

separator =
separator-foreground = ${colors.overlay0}

font-0 = UbuntuMono Nerd Font;1

modules-left = i3 
modules-right = weather wireless-network wired-network fs-root memory cpu battery pulseaudio-control-output bluetooth rofi-usb-mount date calendar tray
cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true
; wm-restack = generic
; wm-restack = bspwm
; wm-restack = i3

; override-redirect = true

[module/i3]
type = internal/i3

; Only show workspaces defined on the same output as the bar
;
; Useful if you want to show monitor specific workspaces
; on different bars
;
; Default: false
pin-workspaces = true

; Show urgent workspaces regardless of whether the workspace is actually hidden 
; by pin-workspaces.
;
; Default: false
; New in version 3.6.0
show-urgent = true

; This will split the workspace name on ':'
; Default: false
strip-wsnumbers = true

; Sort the workspaces by index instead of the default
; sorting that groups the workspaces by output
; Default: false
index-sort = true

; Create click handler used to focus workspace
; Default: true
enable-click = false

; Create scroll handlers used to cycle workspaces
; Default: true
enable-scroll = false

; Wrap around when reaching the first/last workspace
; Default: true
wrapping-scroll = false

; Set the scroll cycle direction 
; Default: true
reverse-scroll = false

; Use fuzzy (partial) matching on labels when assigning 
; icons to workspaces
; Example: code;♚ will apply the icon to all workspaces 
; containing 'code' in the label
; Default: false
fuzzy-match = true

ws-icon-default = 

; Available tags:
;   <label-state> (default) - gets replaced with <label-(focused|unfocused|visible|urgent)>
;   <label-mode> (default)
format = <label-state> <label-mode>

label-mode = %mode%
label-mode-padding = 1
label-mode-background = ${colors.red}

label-focused = 
label-focused-foreground = ${colors.text}
label-focused-background = ${colors.transparent}
label-focused-underline = ${colors.mauve}
label-focused-padding = 1

label-unfocused = %icon%
label-unfocused-padding = 1

label-visible = %icon%
label-visible-underline = ${colors.lavender}
label-visible-padding = 1

label-urgent = %icon%
label-urgent-foreground = ${colors.text}
label-urgent-background = ${colors.red}
label-urgent-padding = 1

[module/weather]
type = custom/script
exec = $HOME/.config/polybar/weather-plugin.sh
tail = false
interval = 960
format-foreground = ${colors.sky}

[module/filesystem]
type = internal/fs
fixed-values = true
interval = 25
spacing = 2

[module/fs-root]
inherit = module/filesystem
mount-0 = /

format-mounted = <label-mounted>
format-mounted-prefix = "󰋊 "
format-mounted-prefix-foreground = ${colors.green}
label-mounted = %percentage_used%%
label-mounted-foreground = ${colors.text}

; Warning colors when disk is getting full
format-warn = <label-warn>
format-warn-prefix = "󰋊 "
format-warn-prefix-foreground = ${colors.yellow}
label-warn = %percentage_used%%
label-warn-foreground = ${colors.yellow}

; Critical colors when disk is almost full
format-full = <label-full>
format-full-prefix = "󰋊 "
format-full-prefix-foreground = ${colors.red}
label-full = %percentage_used%%
label-full-foreground = ${colors.red}

; Thresholds
warn-percentage = 80
full-percentage = 95

[module/fs-home]
inherit = module/filesystem
mount-0 = /home

label-mounted = 󱂵  %free%

[module/pulseaudio]
type = internal/pulseaudio

format-volume-prefix-foreground = ${colors.mauve}
format-volume = <ramp-volume> <label-volume>

label-volume = %percentage%%

label-muted-foreground = ${colors.surface2}

label-muted =  	

interval = 5

ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 

click-right = pavucontrol

[module/pulseaudio-control-output]
type = custom/script
tail = true
format-underline = ${colors.lavender}
label-padding = 2
label-foreground = ${colors.text}

# Icons mixed from Font Awesome 5 and Material Icons
# You can copy-paste your options for each possible action, which is more
# trouble-free but repetitive, or apply only the relevant ones (for example
# --node-blacklist is only needed for next-node).
exec = pulseaudio-control --icons-volume " , " --icon-muted " " --node-nicknames-from "device.description" --node-nickname "alsa_output.pci-0000_00_1b.0.analog-stereo:  Speakers" --node-nickname "alsa_output.usb-Kingston_HyperX_Virtual_Surround_Sound_00000000-00.analog-stereo:  Headphones" listen
click-right = exec pavucontrol &
click-left = pulseaudio-control togmute
click-middle = pulseaudio-control --node-blacklist "alsa_output.pci-0000_01_00.1.hdmi-stereo-extra2" next-node
scroll-up = pulseaudio-control --volume-max 130 up
scroll-down = pulseaudio-control --volume-max 130 down

[module/pulseaudio-control-input]
type = custom/script
tail = true
format-underline = ${colors.lavender}
label-padding = 2
label-foreground = ${colors.text}

# Use --node-blacklist to remove the unwanted PulseAudio .monitor that are child of sinks
exec = pulseaudio-control  --node-type input --icons-volume "" --icon-muted "" --node-nickname "alsa_output.pci-0000_0c_00.3.analog-stereo:  Webcam" --node-nickname "alsa_output.usb-Kingston_HyperX_Virtual_Surround_Sound_00000000-00.analog-stereo:  Headphones" --node-blacklist "*.monitor" listen
click-right = exec pavucontrol &
click-left = pulseaudio-control --node-type input togmute
click-middle = pulseaudio-control --node-type input next-node
scroll-up = pulseaudio-control --node-type input --volume-max 130 up
scroll-down = pulseaudio-control --node-type input --volume-max 130 down

[module/now-playing]
type = custom/script
tail = true
exec = /usr/bin/polybar-now-playing
click-right = "kill -USR1 $(pgrep --oldest --parent %pid%)"

message_display_len = 20
update_delay = 0.3
control_chars = ['','','','']

metadata_fields = ["xesam:title", "xesam:artist"]
metadata_separator = "-"

[module/memory]
type = internal/memory
interval = 2
format = <label>
format-prefix = "󰘚 "
format-prefix-foreground = ${colors.blue}
label = %used%
label-foreground = ${colors.text}

[module/cpu]
type = internal/cpu
interval = 2
format = <label>
format-prefix = "󰍛 "
format-prefix-foreground = ${colors.peach}
label = %percentage%%
label-foreground = ${colors.text}

; Warning when CPU usage is high
warn-percentage = 80
format-warn = <label-warn>
format-warn-prefix = "󰍛 "
format-warn-prefix-foreground = ${colors.yellow}
label-warn = %percentage%%
label-warn-foreground = ${colors.yellow}

[module/wired-network]
type = internal/network
interface = {{ wired_iface }}
interface-type = wired
format-connected = 󰈁 <label-connected>
label-connected =   %downspeed%  %upspeed%
label-connected-foreground = ${colors.lavender}
format-disconnected = 󰈂 <label-disconnected>
label-disconnected = %ifname%
label-disconnected-foreground = ${colors.red} 

format-packetloss = <animation-packetloss> 
animation-packetloss-0 = 󰈀  
animation-packetloss-0-foreground = ${colors.red}
animation-packetloss-1 = 
animation-packetloss-1-foreground = ${colors.surface2}
animation-packetloss-framerate = 500

[module/wireless-network]
type = internal/network
interface = {{ wireless_iface }}
interface-type = wireless
format-connected = 󰖩  <label-connected> <ramp-signal>
label-connected = %essid%  %downspeed%  %upspeed%
label-connected-foreground = ${colors.lavender}
format-disconnected = 󱚼  <label-disconnected>
label-disconnected = %essid%
label-disconnected-foreground = ${colors.red}

format-packetloss = <animation-packetloss> 
animation-packetloss-0 = 󱚵 
animation-packetloss-0-foreground = ${colors.red}
animation-packetloss-1 = 
animation-packetloss-1-foreground = ${colors.surface2}
animation-packetloss-framerate = 500

ramp-signal-0 = 󰢿 
ramp-signal-0-foreground = ${colors.red}
ramp-signal-1 = 󰢼 
ramp-signal-1-foreground = ${colors.yellow}
ramp-signal-2 = 󰢽 
ramp-signal-2-foreground = ${colors.peach}
ramp-signal-3 = 󰢾 
ramp-signal-3-foreground = ${colors.green}

[module/bluetooth]
type = custom/script
exec = $HOME/.config/polybar/bluetooth-status.sh
interval = 5
click-left = rofi-bluetooth &

[module/battery]
type = internal/battery

full-at = 100
low-at = 10

; Use the following command to list batteries and adapters:
; $ ls -1 /sys/class/power_supply/
battery = BAT0
adapter = ADP1

poll-interval = 5

time-format = %H:%M

format-charging = <ramp-capacity>  <label-charging>
format-charging-foreground = ${colors.green}

format-discharging = <ramp-capacity>  <label-discharging>
format-discharging-foreground = ${colors.text}

format-low = <label-low> <animation-low>
format-low-foreground = ${colors.red}

format-full = <ramp-capacity>  <label-full>
format-full-foreground = ${colors.green}

label-charging =  %time% %percentage%%

label-discharging = %percentage%%

label-low = %time% %percentage%%

label-full = %percentage%%

; Only applies if <ramp-capacity> is used
ramp-capacity-0 = 󰂎
ramp-capacity-0-foreground = ${colors.red}
ramp-capacity-1 = 󰁺
ramp-capacity-1-foreground = ${colors.yellow}
ramp-capacity-2 = 󰁿
ramp-capacity-2-foreground = ${colors.yellow}
ramp-capacity-3 = 󰂀
ramp-capacity-3-foreground = ${colors.green}
ramp-capacity-4 = 󰁹
ramp-capacity-4-foreground = ${colors.green}

animation-low-0 = 󰂎
animation-low-0-foreground = ${colors.red}
animation-low-1 = 󰁺
animation-low-1-foreground = ${colors.maroon}
animation-low-framerate = 500

[module/date]
type = internal/date
interval = 1

date = %H:%M:%S

label =  %date%
label-foreground = ${colors.text}
label-font = 1

[module/calendar]
type = custom/script
label = "󰃭"
label-foreground = ${colors.pink}
exec = echo Calendar
click-left = ~/.config/polybar/calendar.sh curr
scroll-up = ~/.config/polybar/calendar.sh next
scroll-down = ~/.config/polybar/calendar.sh prev

[module/rofi-usb-mount]
type = custom/script
exec = ~/.config/polybar/rofi-usb-mount.sh --check
tail = true
format-foreground = ${colors.teal}
click-left = ~/.config/polybar/rofi-usb-mount.sh --mount
click-right = ~/.config/polybar/rofi-usb-mount.sh --umount
click-middle = ~/.config/polybar/rofi-usb-mount.sh --umount-all

[module/pomodoro]
type = custom/script
click-left = i3-gnome-pomodoro toggle
click-middle = gnome-pomodoro
click-right = i3-gnome-pomodoro start_stop
exec = i3-gnome-pomodoro status --always --icon-text " "
interval = 1

[module/tray]
type = internal/tray

format-margin = 8pt
tray-spacing = 16pt
tray-size = 60%
tray-background = ${colors.surface0}

[settings]
screenchange-reload = true
pseudo-transparency = true

; vim:ft=dosini
